# Copie para .env.local, que fica fora do site e fora do Git.
# Não cole chaves no navegador, em src/ ou na conversa.
ACALMO_ROUTER_URL=http://localhost:20128/v1
ACALMO_ROUTER_KEY=
# Nome exato de um modelo ou combo já configurado no seu 9router.
ACALMO_ROUTER_MODEL=
# Opcional: outra rota/combo para a segunda leitura editorial.
ACALMO_REVIEW_MODEL=
# Só ative se todos os fallbacks suportarem JSON mode.
ACALMO_JSON_MODE=false
ACALMO_MAX_TOKENS=3500
ACALMO_REQUEST_TIMEOUT_MS=90000
